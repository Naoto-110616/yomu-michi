{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yomu-michi",
  "compatibility_date": "2026-08-05",
  // /api/* を担う小さな Worker。静的アセットに一致しないリクエストだけがここに来る
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
